{
  "info": {
    "name": "Todo API - Projet Final (v1.0.0)",
    "description": "Collection complète et rejouable du Projet Todo API. Exécutable avec Postman Runner ou Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "admin_token", "value": "" },
    { "key": "user_token", "value": "" },
    { "key": "todo_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentification & Jetons",
      "item": [
        {
          "name": "Santé (route publique)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/health"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK sans jeton', () => pm.response.to.have.status(200));",
                "pm.test('Service opérationnel', () => pm.expect(pm.response.json().status).to.eql('ok'));"
              ]
            }
          }]
        },
        {
          "name": "Login Admin (Obtenir jeton)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK et jeton émis', () => {",
                "  pm.response.to.have.status(200);",
                "  const data = pm.response.json();",
                "  pm.expect(data.token_type).to.eql('Bearer');",
                "  pm.expect(data.token).to.be.a('string');",
                "  pm.collectionVariables.set('admin_token', data.token);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Login User (Obtenir jeton standard)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK et jeton user émis', () => {",
                "  pm.response.to.have.status(200);",
                "  const data = pm.response.json();",
                "  pm.expect(data.token_type).to.eql('Bearer');",
                "  pm.collectionVariables.set('user_token', data.token);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Vérifier identité admin (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK et rôle admin présent', () => {",
                "  pm.response.to.have.status(200);",
                "  const data = pm.response.json().data;",
                "  pm.expect(data.username).to.eql('admin');",
                "  pm.expect(data.roles).to.include('admin');",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "2. Scénario Rejouable (Cycle de Vie)",
      "item": [
        {
          "name": "1. Créer une tâche (POST /todos)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Vérifier les sauvegardes {{$timestamp}}\"\n}"
            },
            "url": "{{base_url}}/todos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('201 Created et en-tête Location', () => {",
                "  pm.response.to.have.status(201);",
                "  pm.response.to.have.header('Location');",
                "});",
                "const json = pm.response.json();",
                "pm.collectionVariables.set('todo_id', json.data.id);",
                "// Validation JSON Schema 1",
                "pm.test('Validation JSON Schema: TodoEnvelope', () => {",
                "  pm.response.to.have.jsonSchema({",
                "    type: 'object', required: ['data'],",
                "    properties: {",
                "      data: {",
                "        type: 'object', required: ['id', 'title', 'done', 'created_at'],",
                "        properties: {",
                "          id: { type: 'integer' },",
                "          title: { type: 'string' },",
                "          done: { type: 'boolean' },",
                "          created_at: { type: 'string' }",
                "        }",
                "      }",
                "    }",
                "  });",
                "});"
              ]
            }
          }]
        },
        {
          "name": "2. Lire la tâche créée (GET /todos/:id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/todos/{{todo_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK avec le bon identifiant', () => {",
                "  pm.response.to.have.status(200);",
                "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('todo_id')));",
                "});"
              ]
            }
          }]
        },
        {
          "name": "3. Modifier la tâche (PATCH /todos/:id)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sauvegardes validées\",\n  \"done\": true\n}"
            },
            "url": "{{base_url}}/todos/{{todo_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK et tâche modifiée', () => {",
                "  pm.response.to.have.status(200);",
                "  const data = pm.response.json().data;",
                "  pm.expect(data.done).to.eql(true);",
                "  pm.expect(data.title).to.eql('Sauvegardes validées');",
                "});",
                "// Validation JSON Schema 2",
                "pm.test('Validation JSON Schema: Todo modifié', () => {",
                "  pm.response.to.have.jsonSchema({",
                "    type: 'object', required: ['data'],",
                "    properties: {",
                "      data: {",
                "        type: 'object', required: ['id', 'title', 'done'],",
                "        properties: { done: { type: 'boolean', enum: [true] } }",
                "      }",
                "    }",
                "  });",
                "});"
              ]
            }
          }]
        },
        {
          "name": "4. Filtrer les tâches terminées (GET /todos?done=true)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/todos?done=true"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('200 OK et la tâche modifiée figure dans les tâches terminées', () => {",
                "  pm.response.to.have.status(200);",
                "  const list = pm.response.json().data;",
                "  const id = Number(pm.collectionVariables.get('todo_id'));",
                "  pm.expect(list.some(t => t.id === id && t.done === true)).to.be.true;",
                "});"
              ]
            }
          }]
        },
        {
          "name": "5. Supprimer la tâche (DELETE /todos/:id par Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/todos/{{todo_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('204 No Content sans corps', () => {",
                "  pm.response.to.have.status(204);",
                "  pm.expect(pm.response.text()).to.eql('');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "6. Vérifier la suppression (GET /todos/:id -> 404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/todos/{{todo_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('404 Not Found après suppression', () => {",
                "  pm.response.to.have.status(404);",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "3. Cas d'Erreur & Sécurité",
      "item": [
        {
          "name": "401 - Accès sans jeton",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/todos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('401 Unauthorized et en-tête WWW-Authenticate', () => {",
                "  pm.response.to.have.status(401);",
                "  pm.response.to.have.header('WWW-Authenticate');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "403 - Suppression par simple utilisateur",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": "{{base_url}}/todos/1"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('403 Forbidden pour rôle non-admin', () => {",
                "  pm.response.to.have.status(403);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "404 - Tâche inconnue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/todos/999999"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('404 Not Found', () => {",
                "  pm.response.to.have.status(404);",
                "  pm.expect(pm.response.json()).to.have.property('message');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "422 - Création avec titre manquant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ }" },
            "url": "{{base_url}}/todos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('422 Unprocessable Entity avec erreur sur title', () => {",
                "  pm.response.to.have.status(422);",
                "  pm.expect(pm.response.json().errors).to.have.property('title');",
                "});",
                "// Validation JSON Schema 3",
                "pm.test('Validation JSON Schema: ValidationError', () => {",
                "  pm.response.to.have.jsonSchema({",
                "    type: 'object', required: ['message', 'errors'],",
                "    properties: {",
                "      message: { type: 'string' },",
                "      errors: { type: 'object' }",
                "    }",
                "  });",
                "});"
              ]
            }
          }]
        },
        {
          "name": "422 - PATCH avec corps vide {}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{ }" },
            "url": "{{base_url}}/todos/1"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('422 Unprocessable Entity sur PATCH vide', () => {",
                "  pm.response.to.have.status(422);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "422 - Filtre invalide (?done=maybe)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/todos?done=maybe"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('422 Unprocessable Entity sur filtre done invalide', () => {",
                "  pm.response.to.have.status(422);",
                "  pm.expect(pm.response.json().errors).to.have.property('done');",
                "});"
              ]
            }
          }]
        }
      ]
    }
  ]
}
